# God en Live — Variables d'environnement
# Copier ce fichier en .env pour le developpement local
# Ne jamais committer de vraies cles API

# Cle API OpenAI (optionnelle en dev, necessaire en mode connecte)
VITE_OPENAI_API_KEY=

# Mode de fonctionnement (optionnel, defaut: "demo")
# "demo" → 3 questions seedees sans API
# "connect" → pipeline RAG complet avec API
VITE_APP_MODE=demo
